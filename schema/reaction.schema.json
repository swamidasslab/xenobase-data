{
  "$id": "https://w3id.org/xenosite/xenobase/schema/reaction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "@id": {
      "pattern": "^xbr:[0-9]{7,12}$",
      "type": "string"
    },
    "@type": {
      "type": "string"
    },
    "exactMatch": {
      "description": "SSSOM skos:exactMatch objects mirrored from mappings/reactions.sssom.tsv",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "into": {
      "pattern": "^xbr:[0-9]{7,12}$",
      "type": "string"
    },
    "product": {
      "pattern": "^xbm:[0-9]{7,12}$",
      "type": "string"
    },
    "reactant": {
      "pattern": "^xbm:[0-9]{7,12}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "retired",
        "merged"
      ]
    }
  },
  "required": [
    "@id",
    "status"
  ],
  "title": "XenoBase public reaction",
  "type": "object"
}
