{
  "$id": "https://w3id.org/xenosite/xenobase/schema/molecule",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "@id": {
      "pattern": "^xbm:[0-9]{7,12}$",
      "type": "string"
    },
    "@type": {
      "type": "string"
    },
    "cxsmiles": {
      "description": "Canonical CXSMILES (kind 2); 1:1 with xbm: id.",
      "type": "string"
    },
    "exactMatch": {
      "description": "SSSOM skos:exactMatch objects mirrored from mappings/molecules.sssom.tsv (ChEBI)",
      "items": {
        "pattern": "^CHEBI:[0-9]+$",
        "type": "string"
      },
      "type": "array"
    },
    "hasPart": {
      "description": "SSSOM BFO:0000051 (has part) objects mirrored from mappings/molecules.sssom.tsv",
      "items": {
        "pattern": "^xbm:[0-9]{7,12}$",
        "type": "string"
      },
      "type": "array"
    },
    "into": {
      "pattern": "^xbm:[0-9]{7,12}$",
      "type": "string"
    },
    "names": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "smiles": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "retired",
        "merged"
      ]
    },
    "xrefs": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "@id",
    "status"
  ],
  "title": "XenoBase public molecule",
  "type": "object"
}
