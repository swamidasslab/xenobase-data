{
  "$defs": {
    "blankId": {
      "pattern": "^_:(ctx|claim)_[0-9a-f]{8,32}$",
      "type": "string"
    },
    "claim": {
      "additionalProperties": false,
      "properties": {
        "@id": {
          "$ref": "#/$defs/blankId"
        },
        "@type": {
          "const": "xb:Claim"
        },
        "context": {
          "$ref": "#/$defs/blankId"
        },
        "dataset": {
          "minLength": 1,
          "type": "string"
        },
        "result": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "class": {
                "pattern": "^xb:(observed|notObserved|major|minor)$",
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "qty": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "number": {
                      "type": "number"
                    },
                    "role": {
                      "enum": [
                        "value",
                        "min",
                        "max",
                        "time"
                      ],
                      "type": "string"
                    },
                    "unit": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "role",
                    "number"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "source": {
                "additionalProperties": false,
                "description": "Where the value sits in the source (MetaPath data table cell), to rebuild the table grid.",
                "properties": {
                  "cell": {
                    "type": "string"
                  },
                  "col": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  },
                  "row": {
                    "type": "string"
                  },
                  "table": {
                    "type": "string"
                  },
                  "table_title": {
                    "type": "string"
                  },
                  "xbt": {
                    "pattern": "^xbt:",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "tips": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "class",
              "tips",
              "qty"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "subject": {
          "items": {
            "pattern": "^(xbm|xbr|xbn):",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "supportedBy": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "@id",
        "@type",
        "context",
        "subject",
        "result",
        "dataset"
      ],
      "type": "object"
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "@id": {
          "$ref": "#/$defs/blankId"
        },
        "@type": {
          "const": "xb:Context"
        },
        "doseNumber": {
          "type": "number"
        },
        "doseUnit": {
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "meta": {
          "additionalProperties": false,
          "description": "Literal text the source states about this setup (e.g. a MetaPath column's report header, linked study, caption and note), with the curator corrections applied to it and the open audit findings on it. Curation status itself is a tip (xbctx:curation/corrected | xbctx:curation/inconsistent).",
          "properties": {
            "caption": {
              "type": "string"
            },
            "corrections": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "findings": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "header": {
              "type": "string"
            },
            "layouts": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "fields": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "rows": {
                    "items": {
                      "properties": {
                        "bad": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "role": {
                          "enum": [
                            "subject",
                            "shares",
                            "unused"
                          ],
                          "type": "string"
                        },
                        "why": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "role",
                        "bad"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "fields",
                  "rows"
                ],
                "type": "object"
              },
              "description": "Finding id → the columns behind it as the source stores them, one cell per field; bad names the cells that disagree.",
              "type": "object"
            },
            "note": {
              "type": "string"
            },
            "study": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "organism": {
          "pattern": "^taxon:[0-9]+$",
          "type": "string"
        },
        "parent": {
          "pattern": "^(xbm|xbn):",
          "type": "string"
        },
        "tips": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "@id",
        "@type"
      ],
      "type": "object"
    }
  },
  "$id": "https://w3id.org/xenosite/xenobase/schema/claim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Blank-node Context or Claim in claims.yaml (@graph). No public claim CURIEs.",
  "oneOf": [
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/claim"
    }
  ],
  "title": "XenoBase public claim or context node"
}
