<https://w3id.org/xenosite/xenobase/ontology> a owl:Ontology ;
  rdfs:label "XenoBase context and taxon ontology" ;
  rdfs:comment "Local xb:/xbctx: tips, NCBITaxon subset, HGNC enzyme gene-group hierarchy, and crosswalks dumped from Postgres." .

xb:Claim a owl:Class ; rdfs:label "Claim" .
xb:Context a owl:Class ; rdfs:label "Claim context" .
xb:observed a owl:Class ; rdfs:label "Observed result" .
xb:notObserved a owl:Class ; rdfs:label "Not observed result" .
xb:major a owl:Class ; rdfs:subClassOf xb:observed ; rdfs:label "Major" .
xb:minor a owl:Class ; rdfs:subClassOf xb:observed ; rdfs:label "Minor" .

xb:context a owl:ObjectProperty ; rdfs:domain xb:Claim ; rdfs:range xb:Context .
xb:subject a owl:ObjectProperty ; rdfs:domain xb:Claim .
xb:result a owl:ObjectProperty ; rdfs:domain xb:Claim .
xb:dataset a owl:ObjectProperty ; rdfs:domain xb:Claim .
xb:supportedBy a owl:ObjectProperty ; rdfs:domain xb:Claim .
xb:organism a owl:ObjectProperty ; rdfs:domain xb:Context .
xb:parent a owl:ObjectProperty ; rdfs:domain xb:Context .
skos:exactMatch a owl:ObjectProperty .
skos:broader a owl:ObjectProperty ;
  rdfs:comment "Enzyme gene → gene-group and child-group → parent-group." .

